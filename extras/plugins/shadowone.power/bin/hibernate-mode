#!/usr/bin/env bash
# hibernate-mode: sleep first, then hibernate after a while (suspend-then-hibernate).
#
#   hibernate-mode on [DELAY]     turn it on (DELAY: 30min 1h 2h 3h 6h; default 3h)
#   hibernate-mode off            turn it off and delete the swapfile
#   hibernate-mode delay DELAY    how long it sleeps before hibernating
#   hibernate-mode status         show the current state
#   hibernate-mode --shell        the same as key<TAB>value lines, for the Battery panel
#
# Reading needs no root. Changes go through the root helper
# /usr/local/libexec/hibernate-mode-root with pkexec, which asks for your
# fingerprint or password; root/install.sh installs it once.

set -euo pipefail

HELPER=/usr/local/libexec/hibernate-mode-root
POLICY=/usr/share/polkit-1/actions/io.github.shadowone.hibernate-mode.policy
SWAP_FILE=/swap/swapfile
RESUME_HOOK=/etc/mkinitcpio.conf.d/omarchy_resume.conf
RESUME_CONF=/etc/limine-entry-tool.d/resume.conf
MIN_FREE_GB=24
DEFAULT_DELAY=3h

die() { echo "hibernate-mode: $*" >&2; exit 1; }

here=$(dirname "$(readlink -f "$0")")
bundled=$(readlink -f "$here/../root/hibernate-mode-root")
installer="$(dirname "$bundled")/install.sh"
setup_command="sudo bash ${installer/#$HOME/\~}"

# Last value of a setting in `systemd-analyze cat-config` output (main file
# plus drop-ins, in the order systemd applies them).
setting() { # setting <cat-config text> <Key> <default>
  local value
  value=$(sed -n "s/^$2=//p" <<<"$1" | tail -1)
  echo "${value:-$3}"
}

helper_state() {
  if [[ ! -f $HELPER || ! -f $POLICY ]]; then
    echo missing
  elif [[ $(stat -c %u "$HELPER") != 0 ]] || ! cmp -s "$HELPER" "$bundled"; then
    echo outdated
  else
    echo ok
  fi
}

unsupported_reason() {
  [[ -f /sys/power/image_size ]] || { echo "This kernel can't hibernate"; return; }
  command -v limine-mkinitcpio >/dev/null || { echo "Needs the Limine bootloader"; return; }
  if [[ -r /sys/kernel/security/lockdown ]] && ! grep -q '\[none\]' /sys/kernel/security/lockdown; then
    echo "Secure Boot lockdown blocks hibernation"
  fi
}

load() {
  REASON=$(unsupported_reason)
  SWAP_ACTIVE=no
  awk 'NR > 1 { print $1 }' /proc/swaps | grep -Fxq "$SWAP_FILE" && SWAP_ACTIVE=yes
  SWAP_BYTES=$(stat -c %s "$SWAP_FILE" 2>/dev/null || echo 0)
  RESUME=no
  [[ -f $RESUME_HOOK && -f $RESUME_CONF ]] && RESUME=yes
  local logind sleep
  logind=$(systemd-analyze cat-config systemd/logind.conf 2>/dev/null || true)
  sleep=$(systemd-analyze cat-config systemd/sleep.conf 2>/dev/null || true)
  LID=$(setting "$logind" HandleLidSwitch suspend)
  DELAY=$(setting "$sleep" HibernateDelaySec "")
  ON_AC=$(setting "$sleep" HibernateOnACPower yes)
  ENABLED=no
  [[ $SWAP_ACTIVE == yes && $RESUME == yes && $LID =~ ^(sleep|suspend-then-hibernate)$ ]] && ENABLED=yes
  # The boot entry changed since this boot (just turned on, or the swapfile moved).
  RESTART=no
  local configured running
  configured=$(grep -o 'resume_offset=[0-9]*' "$RESUME_CONF" 2>/dev/null | cut -d= -f2 || true)
  running=$(cat /sys/power/resume_offset 2>/dev/null || echo 0)
  [[ $ENABLED == yes && -n $configured && $configured != "$running" ]] && RESTART=yes
  FREE_GB=$(df --output=avail -BG / | tail -1 | tr -dc 0-9)
  HELPER_STATE=$(helper_state)
}

cmd_shell() {
  [[ -z $REASON ]] && printf 'supported\tyes\n' || printf 'supported\tno\nreason\t%s\n' "$REASON"
  printf 'enabled\t%s\nswap_active\t%s\nswap_bytes\t%s\nresume\t%s\n' "$ENABLED" "$SWAP_ACTIVE" "$SWAP_BYTES" "$RESUME"
  printf 'lid\t%s\ndelay\t%s\non_ac\t%s\nrestart\t%s\n' "$LID" "$DELAY" "$ON_AC" "$RESTART"
  printf 'free_gb\t%s\nneed_gb\t%s\nhelper\t%s\nsetup\t%s\n' "$FREE_GB" "$MIN_FREE_GB" "$HELPER_STATE" "$setup_command"
}

cmd_status() {
  if [[ -n $REASON ]]; then
    echo "Hibernation: not available ($REASON)"
  elif [[ $ENABLED == yes ]]; then
    echo "Hibernation: on, hibernates after ${DELAY:-?} of sleep$([[ $ON_AC == no ]] && echo " on battery")"
    [[ $RESTART == yes ]] && echo "             restart once so the new boot entry is used"
  else
    echo "Hibernation: off (closing the lid only sleeps)"
  fi
  if [[ $SWAP_BYTES != 0 ]]; then
    echo "Swapfile:    $SWAP_FILE, $((SWAP_BYTES / 1024 / 1024 / 1024)) GB, $([[ $SWAP_ACTIVE == yes ]] && echo active || echo not active)"
  fi
  echo "Lid close:   $LID"
  case $HELPER_STATE in
    missing) echo "Helper:      not installed: $setup_command" ;;
    outdated) echo "Helper:      outdated: $setup_command" ;;
  esac
  return 0
}

run_helper() {
  [[ -z $REASON ]] || die "$REASON"
  case $HELPER_STATE in
    missing) die "the root helper is not installed: $setup_command" ;;
    outdated) die "the root helper is outdated: $setup_command" ;;
  esac
  local rc=0
  pkexec "$HELPER" "$@" || rc=$?
  case $rc in
    0) ;;
    126 | 127) die "authentication cancelled" ;;
    *) exit "$rc" ;;
  esac
}

valid_delay() { [[ $1 =~ ^(30min|1h|2h|3h|6h)$ ]] || die "DELAY must be 30min, 1h, 2h, 3h or 6h"; }

case ${1:-status} in
  -h | --help | help) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac
load
case ${1:-status} in
  on)
    delay=${2:-${DELAY:-$DEFAULT_DELAY}}
    valid_delay "$delay"
    run_helper on "$delay"
    ;;
  off) run_helper off ;;
  delay)
    [[ $# -eq 2 ]] || die "usage: hibernate-mode delay 30min|1h|2h|3h|6h"
    valid_delay "$2"
    run_helper delay "$2"
    ;;
  status) cmd_status ;;
  --shell) cmd_shell ;;
  *) die "unknown command '$1' (use on, off, delay or status)" ;;
esac

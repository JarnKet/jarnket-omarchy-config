#!/usr/bin/python3 -IB
# Disk Keeper command line. Run `diskkeeper --help`.
# -I keeps the user's site-packages and cwd out of sys.path; -B (and the line
# below) keep Python from writing __pycache__ into the plugin folder, which
# would make the Omarchy shell reload every plugin.
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "backend"))

from diskkeeper.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))

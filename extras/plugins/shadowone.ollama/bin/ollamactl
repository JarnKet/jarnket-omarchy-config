#!/usr/bin/env -S python3 -IB
"""ollamactl: helper for the Ollama bar panel (also handy in a terminal).

  ollamactl status [--full]      JSON: service, version, models, loaded models, memory
  ollamactl pull NAME...         download models one after another; a second call
                                 while one runs adds to its queue
  ollamactl cancel               stop the running download (it resumes next time)
  ollamactl rm NAME              delete a model
  ollamactl load NAME            load a model into memory now
  ollamactl unload [NAME]        free memory (every loaded model without NAME)
  ollamactl test NAME            short Lao prompt; prints speed and the answer
  ollamactl use NAME             make NAME the local model of Ask Claude
  ollamactl service ACTION       start | stop | restart | enable | disable

It talks to the Ollama HTTP API on localhost and to the systemd user unit
ollama.service. Download progress lives in ~/.local/state/ollama-panel/pull.json
so the panel can show it and it survives a shell restart.
"""

import fcntl
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "ollama-panel")
PULL_FILE = os.path.join(STATE_DIR, "pull.json")
QUEUE_FILE = os.path.join(STATE_DIR, "pull-queue.txt")
TESTS_FILE = os.path.join(STATE_DIR, "tests.json")
SHOW_CACHE = os.path.join(STATE_DIR, "show-cache.json")
TAGS_CACHE = os.path.join(STATE_DIR, "tags-cache.json")
ASK_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "ask-claude")
ASK_MODEL_FILE = os.path.join(ASK_DIR, "local-model")
UNIT = "ollama.service"

PULL_ATTEMPTS = 3
PERMANENT_PULL_ERROR = re.compile(r"does not exist|not found|manifest unknown|invalid model|unauthorized", re.I)

TEST_PROMPT = "ແນະນຳນະຄອນຫຼວງວຽງຈັນໃຫ້ນັກທ່ອງທ່ຽວ ເປັນພາສາລາວ 3 ປະໂຫຍກສັ້ນໆ."


def api_base():
    host = os.environ.get("OLLAMA_HOST", "").strip() or "127.0.0.1:11434"
    if not host.startswith(("http://", "https://")):
        host = "http://" + host
    return host.rstrip("/")


API = api_base()


def request(path, body=None, method=None, timeout=5):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(API + path, data=data, method=method or ("POST" if data else "GET"),
                                 headers={"Content-Type": "application/json"})
    return urllib.request.urlopen(req, timeout=timeout)


def call(path, body=None, method=None, timeout=5):
    with request(path, body, method, timeout) as response:
        raw = response.read()
    return json.loads(raw) if raw.strip() else {}


def api_error(error):
    if isinstance(error, urllib.error.HTTPError):
        try:
            return json.loads(error.read()).get("error") or str(error)
        except (ValueError, AttributeError):
            return str(error)
    if isinstance(error, urllib.error.URLError):
        return "Ollama is not running"
    return str(error)


def read_json(path, fallback):
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return fallback


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temp = path + ".tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        json.dump(data, handle, ensure_ascii=False)
    os.replace(temp, path)


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def systemctl(*args):
    try:
        done = subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=20)
        return done.returncode, (done.stdout.strip() or done.stderr.strip())
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, str(error)


def unit_state():
    code, text = systemctl("show", UNIT, "-p", "LoadState,ActiveState,UnitFileState,MainPID")
    props = dict(line.split("=", 1) for line in text.splitlines() if "=" in line) if code == 0 else {}
    unit_known = props.get("LoadState") == "loaded"
    return {
        "unit": unit_known,
        "active": props.get("ActiveState", "unknown") if unit_known else "missing",
        "enabled": props.get("UnitFileState", "unknown") if unit_known else "missing",
        "pid": int(props.get("MainPID") or 0),
    }


def meminfo():
    values = {}
    try:
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0]) * 1024
    except OSError:
        pass
    memory = {"ramTotal": values.get("MemTotal", 0), "ramAvailable": values.get("MemAvailable", 0)}
    # Integrated GPU: VRAM is a small carve-out, the rest is GTT (system RAM the GPU may map).
    for card in sorted(os.listdir("/sys/class/drm")) if os.path.isdir("/sys/class/drm") else []:
        device = os.path.join("/sys/class/drm", card, "device")
        if not os.path.exists(os.path.join(device, "mem_info_gtt_total")):
            continue
        for key, name in (("gttTotal", "mem_info_gtt_total"), ("gttUsed", "mem_info_gtt_used"),
                          ("vramTotal", "mem_info_vram_total"), ("vramUsed", "mem_info_vram_used")):
            try:
                with open(os.path.join(device, name)) as handle:
                    memory[key] = int(handle.read().strip())
            except (OSError, ValueError):
                pass
        break
    return memory


def gpu_from_journal():
    """The 'inference compute' line Ollama logs at start: which GPU and library it found."""
    try:
        done = subprocess.run(["journalctl", "--user", "-u", UNIT, "-b", "-o", "cat", "--no-pager",
                               "-g", "inference compute", "-n", "5"],
                              capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    found = {}
    for line in done.stdout.splitlines():
        if "inference compute" not in line:
            continue
        library = re.search(r"library=(\S+)", line)
        name = re.search(r'description="([^"]+)"', line) or re.search(r'name=(\S+)', line)
        total = re.search(r'total="([^"]+)"', line)
        found = {"library": library.group(1) if library else "",
                 "name": name.group(1) if name else "",
                 "total": total.group(1) if total else ""}
    return found


def show(name, digest, cache):
    entry = cache.get(digest)
    if entry:
        return entry
    try:
        data = call("/api/show", {"model": name}, timeout=10)
    except (urllib.error.URLError, OSError, ValueError):
        return {}
    info = data.get("model_info") or {}
    arch = info.get("general.architecture", "")
    entry = {
        "capabilities": data.get("capabilities") or [],
        "context": info.get(arch + ".context_length") or 0,
        "arch": arch,
        "license": (data.get("license") or "").strip().splitlines()[0][:80] if data.get("license") else "",
    }
    cache[digest] = entry
    return entry


def ask_model():
    try:
        with open(ASK_MODEL_FILE) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def models_dir():
    return os.environ.get("OLLAMA_MODELS") or os.path.join(HOME, ".ollama/models")


def server_key(pid):
    """Changes when the server restarts or is upgraded, or a model manifest is added or removed."""
    binary = shutil.which("ollama") or ""
    try:
        built = os.stat(binary).st_mtime_ns if binary else 0
    except OSError:
        built = 0
    manifests = []
    root = os.path.join(models_dir(), "manifests")
    for folder, _, files in os.walk(root):
        for name in files:
            path = os.path.join(folder, name)
            try:
                info = os.stat(path)
            except OSError:
                continue
            manifests.append("%s:%d:%d" % (os.path.relpath(path, root), info.st_mtime_ns, info.st_size))
    return "|".join([str(pid), str(built)] + sorted(manifests))


def cmd_status(args):
    full = "--full" in args
    out = {
        "installed": shutil.which("ollama") is not None,
        "service": unit_state(),
        "running": False,
        "version": "",
        "models": [],
        "loaded": [],
        "memory": meminfo(),
        "askModel": ask_model(),
        "pull": read_json(PULL_FILE, {}),
        "tests": read_json(TESTS_FILE, {}),
        "api": API,
        "error": "",
    }
    pull = out["pull"]
    if pull.get("state") == "running" and not pid_alive(pull.get("pid")):
        pull["state"] = "stopped"
    target = models_dir()
    while target != "/" and not os.path.exists(target):
        target = os.path.dirname(target)
    try:
        stat = os.statvfs(target)
        out["diskFree"] = stat.f_bavail * stat.f_frsize
    except OSError:
        out["diskFree"] = 0
    # Ollama logs every request to the journal, so a poll asks only /api/ps; version and
    # model list are reused until the server restarts or a model is added or removed.
    try:
        ps = call("/api/ps", timeout=3).get("models") or []
        out["running"] = True
    except (urllib.error.URLError, OSError, ValueError) as error:
        out["error"] = api_error(error)
    if out["running"]:
        cache = read_json(SHOW_CACHE, {})
        size_before = len(cache)
        try:
            for model in ps:
                out["loaded"].append({
                    "name": model.get("name") or model.get("model", ""),
                    "size": model.get("size", 0),
                    "vram": model.get("size_vram", 0),
                    "expires": model.get("expires_at", ""),
                    "context": model.get("context_length", 0),
                })
            key = server_key(out["service"]["pid"])
            tags = read_json(TAGS_CACHE, {})
            if tags.get("key") != key:
                tags = {"key": key,
                        "version": call("/api/version", timeout=2).get("version", ""),
                        "models": call("/api/tags", timeout=5).get("models") or []}
                write_json(TAGS_CACHE, tags)
            out["version"] = tags.get("version", "")
            for model in tags.get("models") or []:
                details = model.get("details") or {}
                entry = {
                    "name": model.get("name") or model.get("model", ""),
                    "size": model.get("size", 0),
                    "modified": model.get("modified_at", ""),
                    "digest": (model.get("digest") or "")[:12],
                    "family": details.get("family", ""),
                    "params": details.get("parameter_size", ""),
                    "quant": details.get("quantization_level", ""),
                    "format": details.get("format", ""),
                }
                entry.update(show(entry["name"], model.get("digest") or entry["name"], cache))
                out["models"].append(entry)
        except (urllib.error.URLError, OSError, ValueError) as error:
            out["error"] = api_error(error)
        if len(cache) != size_before:
            write_json(SHOW_CACHE, cache)
        out["models"].sort(key=lambda m: m["name"])
        out["diskUsed"] = sum(m["size"] for m in out["models"])
    if full and out["service"]["active"] == "active":
        out["gpu"] = gpu_from_journal()
    print(json.dumps(out, ensure_ascii=False))
    return 0


# ------------------------------------------------------------------ pull

def registry_size(name):
    """Whole download size from the registry manifest; Ollama reports a layer only once it starts."""
    ref, _, tag = name.partition(":")
    parts = ref.split("/")
    if len(parts) <= 2:
        host, path = "registry.ollama.ai", ref if len(parts) == 2 else "library/" + ref
    else:
        host, path = parts[0], "/".join(parts[1:])
    req = urllib.request.Request("https://%s/v2/%s/manifests/%s" % (host, path, tag or "latest"),
                                 headers={"Accept": "application/vnd.docker.distribution.manifest.v2+json"})
    for _attempt in range(2):
        try:
            with urllib.request.urlopen(req, timeout=10) as response:
                manifest = json.loads(response.read())
            return (sum(layer.get("size", 0) for layer in manifest.get("layers") or [])
                    + (manifest.get("config") or {}).get("size", 0))
        except urllib.error.HTTPError:
            return 0
        except (urllib.error.URLError, OSError, ValueError, AttributeError):
            continue
    return 0


def take_queue():
    """Pop the next queued name (added by another `ollamactl pull` while this one runs)."""
    try:
        with open(QUEUE_FILE, "r+") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            names = [n.strip() for n in handle.read().splitlines() if n.strip()]
            handle.seek(0)
            handle.truncate()
            handle.write("".join(n + "\n" for n in names[1:]))
            return names[0] if names else None
    except OSError:
        return None


def queued():
    try:
        with open(QUEUE_FILE) as handle:
            return [n.strip() for n in handle.read().splitlines() if n.strip()]
    except OSError:
        return []


def cmd_pull(names):
    names = [n.strip() for n in names if n.strip()]
    if not names:
        print("ollamactl pull: name a model, e.g. gemma4:e4b-it-qat", file=sys.stderr)
        return 2
    os.makedirs(STATE_DIR, exist_ok=True)
    current = read_json(PULL_FILE, {})
    if current.get("state") == "running" and pid_alive(current.get("pid")) and current.get("pid") != os.getpid():
        with open(QUEUE_FILE, "a") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            handle.write("".join(n + "\n" for n in names))
        print("queued after %s: %s" % (current.get("model"), ", ".join(names)))
        return 0
    with open(QUEUE_FILE, "w") as handle:
        handle.write("".join(n + "\n" for n in names[1:]))

    tty = sys.stdout.isatty()
    state = {"state": "running", "pid": os.getpid(), "model": "", "status": "", "completed": 0, "total": 0,
             "speed": 0, "started": time.time(), "finished": [], "failed": [], "error": "", "queue": []}

    def save():
        state["queue"] = queued()
        write_json(PULL_FILE, state)

    def stop(_signum, _frame):
        state["state"] = "cancelled"
        state["status"] = "cancelled"
        save()
        try:
            os.remove(QUEUE_FILE)
        except OSError:
            pass
        sys.exit(130)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    def fetch(name, expected):
        layers = {}
        last_save = 0
        window = []
        with request("/api/pull", {"model": name, "stream": True}, timeout=60) as response:
            for raw in response:
                try:
                    event = json.loads(raw)
                except ValueError:
                    continue
                if event.get("error"):
                    raise RuntimeError(event["error"])
                state["status"] = event.get("status", "")
                digest = event.get("digest")
                if digest and event.get("total"):
                    layers[digest] = (event.get("completed", 0), event["total"])
                state["completed"] = sum(c for c, _ in layers.values())
                state["total"] = max(expected, sum(t for _, t in layers.values()))
                now = time.monotonic()
                window.append((now, state["completed"]))
                while len(window) > 2 and now - window[0][0] > 5:
                    window.pop(0)
                if len(window) > 1 and window[-1][0] > window[0][0]:
                    state["speed"] = max(0, (window[-1][1] - window[0][1]) / (window[-1][0] - window[0][0]))
                if now - last_save > 0.5:
                    last_save = now
                    save()
                    if tty and state["total"]:
                        sys.stdout.write("\r%s  %5.1f%%  %s/s   " % (
                            name, 100.0 * state["completed"] / state["total"], human(state["speed"])))
                        sys.stdout.flush()
        if state["status"] != "success":
            raise RuntimeError("the download stopped before it finished")

    name = names[0]
    while name:
        state.update({"model": name, "status": "starting", "completed": 0, "total": 0, "speed": 0, "error": ""})
        save()
        expected = registry_size(name)
        # A dropped connection, or a pull right after a cancel (Ollama joins the dying
        # download), fails fast; Ollama keeps the partial files, so trying again resumes.
        for attempt in range(1, PULL_ATTEMPTS + 1):
            try:
                fetch(name, expected)
                state["finished"].append(name)
                if tty:
                    print("\r%s  done%s" % (name, " " * 30))
                break
            except (urllib.error.URLError, OSError, RuntimeError, ValueError) as error:
                message = api_error(error) if not isinstance(error, RuntimeError) else str(error)
                if attempt < PULL_ATTEMPTS and not PERMANENT_PULL_ERROR.search(message):
                    state["status"] = "retrying (%s)" % message
                    state["speed"] = 0
                    save()
                    time.sleep(5 * attempt)
                    continue
                state["failed"].append(name)
                state["error"] = "%s: %s" % (name, message)
                if tty:
                    print("\r%s  failed: %s" % (name, message))
                break
        save()
        name = take_queue()
    state["state"] = "error" if state["failed"] else "done"
    state["status"] = ""
    state["speed"] = 0
    state["ended"] = time.time()
    save()
    return 1 if state["failed"] else 0


def cmd_cancel(_args):
    current = read_json(PULL_FILE, {})
    if current.get("state") != "running" or not pid_alive(current.get("pid")):
        print("no download is running")
        return 0
    os.kill(int(current["pid"]), signal.SIGTERM)
    print("cancelled %s (partial files are kept; pulling again resumes)" % current.get("model"))
    return 0


def human(n):
    n = float(n or 0)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return ("%.0f %s" if unit in ("B", "KB") else "%.1f %s") % (n, unit)
        n /= 1000.0
    return "%d B" % n


# ------------------------------------------------------------------ models

def one_name(args, verb):
    if not args:
        print("ollamactl %s: name a model" % verb, file=sys.stderr)
        sys.exit(2)
    return args[0]


def cmd_rm(args):
    name = one_name(args, "rm")
    try:
        call("/api/delete", {"model": name}, method="DELETE", timeout=30)
    except (urllib.error.URLError, OSError) as error:
        print("ollamactl rm: %s" % api_error(error), file=sys.stderr)
        return 1
    tests = read_json(TESTS_FILE, {})
    if tests.pop(name, None) is not None:
        write_json(TESTS_FILE, tests)
    print("deleted %s" % name)
    return 0


def cmd_load(args):
    name = one_name(args, "load")
    try:
        call("/api/generate", {"model": name}, timeout=600)
    except (urllib.error.URLError, OSError) as error:
        print("ollamactl load: %s" % api_error(error), file=sys.stderr)
        return 1
    print("loaded %s" % name)
    return 0


def cmd_unload(args):
    try:
        names = args or [m.get("name") for m in call("/api/ps").get("models") or []]
        for name in names:
            call("/api/generate", {"model": name, "keep_alive": 0}, timeout=60)
            print("unloaded %s" % name)
    except (urllib.error.URLError, OSError) as error:
        print("ollamactl unload: %s" % api_error(error), file=sys.stderr)
        return 1
    return 0


def capabilities(name):
    try:
        return call("/api/show", {"model": name}, timeout=10).get("capabilities") or []
    except (urllib.error.URLError, OSError, ValueError):
        return []


def cmd_test(args):
    name = one_name(args, "test")
    body = {"model": name, "prompt": TEST_PROMPT, "stream": False, "options": {"num_predict": 320}}
    if "thinking" in capabilities(name):
        body["think"] = False
    started = time.time()
    try:
        data = call("/api/generate", body, timeout=900)
        loaded = call("/api/ps").get("models") or []
    except (urllib.error.URLError, OSError, ValueError) as error:
        print(json.dumps({"model": name, "error": api_error(error)}, ensure_ascii=False))
        return 1

    def rate(count, duration):
        return round(count / (duration / 1e9), 1) if count and duration else 0

    gpu = 0
    for model in loaded:
        if (model.get("name") or model.get("model")) == name and model.get("size"):
            gpu = round(100.0 * model.get("size_vram", 0) / model["size"])
    result = {
        "model": name,
        "at": int(started),
        "tps": rate(data.get("eval_count"), data.get("eval_duration")),
        "promptTps": rate(data.get("prompt_eval_count"), data.get("prompt_eval_duration")),
        "loadS": round((data.get("load_duration") or 0) / 1e9, 1),
        "totalS": round((data.get("total_duration") or 0) / 1e9, 1),
        "tokens": data.get("eval_count", 0),
        "gpu": gpu,
        "text": (data.get("response") or "").strip()[:700],
    }
    tests = read_json(TESTS_FILE, {})
    tests[name] = result
    write_json(TESTS_FILE, tests)
    print(json.dumps(result, ensure_ascii=False))
    return 0


def cmd_use(args):
    name = one_name(args, "use")
    os.makedirs(ASK_DIR, exist_ok=True)
    with open(ASK_MODEL_FILE, "w") as handle:
        handle.write(name + "\n")
    print("Ask Claude will use %s offline" % name)
    return 0


def cmd_service(args):
    action = one_name(args, "service")
    if action not in ("start", "stop", "restart", "enable", "disable"):
        print("ollamactl service: start | stop | restart | enable | disable", file=sys.stderr)
        return 2
    code, output = systemctl(action, UNIT)
    if output:
        print(output)
    return code


COMMANDS = {
    "status": cmd_status, "pull": cmd_pull, "cancel": cmd_cancel, "rm": cmd_rm, "load": cmd_load,
    "unload": cmd_unload, "test": cmd_test, "use": cmd_use, "service": cmd_service,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__.strip())
        return 0 if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help") else 2
    return COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())

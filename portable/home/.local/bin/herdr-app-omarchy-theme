#!/usr/bin/env python3
"""Write the current Omarchy theme as a Herdr app theme and switch to it.

Terminal colors come from the theme's generated ghostty.conf, so Herdr's
terminals match the Omarchy terminals exactly; the window chrome (sidebar,
canvas, borders, focus accent) comes from colors.toml.

The theme goes to ~/.config/herdr-app/themes/omarchy-<theme>-<hash>.json and
settings.json's "theme" is pointed at it. A new name every time the colors
change is what makes the open window repaint: herdr-app re-reads a theme file
only when settings change (settings::set compares the settings, which hold
the theme's name, not its colors), so rewriting one file in place is ignored
until a restart. Older omarchy-* files are removed. A theme the person picked
in Herdr itself (any name not starting with "omarchy") is left alone.

Run by the Omarchy theme-set hook (~/.config/omarchy/hooks/theme-set.d/),
or by hand after editing a theme.
"""
import glob
import hashlib
import json
import os
import re
import tomllib

STATE = os.path.expanduser("~/.local/state/omarchy/current")
THEME = os.path.join(STATE, "theme")
HOME = os.path.expanduser("~/.config/herdr-app")
SETTINGS = os.path.join(HOME, "settings.json")
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")


def ghostty(path):
    conf, ansi = {}, {}
    for line in open(path, encoding="utf-8"):
        key, _, value = (part.strip() for part in line.partition("="))
        if key == "palette":
            index, _, color = value.partition("=")
            ansi[int(index)] = color.strip()
        elif key:
            conf[key] = value
    return conf, [ansi[i] for i in range(16)]


def write_atomic(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


conf, ansi = ghostty(os.path.join(THEME, "ghostty.conf"))
try:
    with open(os.path.join(THEME, "colors.toml"), "rb") as f:
        colors = tomllib.load(f)
except FileNotFoundError:
    colors = {}


def pick(*keys):
    for key in keys:
        value = colors.get(key)
        if isinstance(value, str) and HEX.match(value):
            return value.lower()
    return None


theme = {
    "background": conf["background"],
    "foreground": conf["foreground"],
    "selection": conf.get("selection-background", pick("selection") or ansi[8]),
    "cursor": conf.get("cursor-color", conf["foreground"]),
    "ansi": ansi,
}
# Chrome roles Herdr would otherwise derive from the terminal colors.
chrome = {
    "chrome": pick("dark_background", "background"),
    "canvas": pick("dark_background", "background"),
    "border": pick("lighter_background", "selection"),
    "accent": pick("accent", "blue"),
    "accent_foreground": pick("dark_background", "background"),
    "muted": pick("muted", "light_foreground"),
}
theme["colors"] = {k: v for k, v in chrome.items() if v}

text = json.dumps(theme, indent=2) + "\n"
slug = re.sub(r"[^a-z0-9-]+", "-", open(os.path.join(STATE, "theme.name")).read().strip().lower())
name = f"omarchy-{slug}-{hashlib.sha1(text.encode()).hexdigest()[:6]}"
os.makedirs(os.path.join(HOME, "themes"), exist_ok=True)
write_atomic(os.path.join(HOME, "themes", f"{name}.json"), text)

try:
    with open(SETTINGS, encoding="utf-8") as f:
        settings = json.load(f)
except FileNotFoundError:
    settings = {}
current = settings.get("theme")
if current is None or (isinstance(current, str) and current.startswith("omarchy")):
    if current != name:
        settings["theme"] = name
        write_atomic(SETTINGS, json.dumps(settings, indent=2) + "\n")
    for old in glob.glob(os.path.join(HOME, "themes", "omarchy*.json")):
        if os.path.basename(old) != f"{name}.json":
            os.remove(old)
    print(f"herdr-app theme: {name}")
else:
    print(f"herdr-app theme: wrote {name}; left settings on {current!r}")

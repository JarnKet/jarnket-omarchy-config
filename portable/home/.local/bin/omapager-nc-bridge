#!/usr/bin/env bash
#
# omapager -> Notification Center bridge.
#
# Omapager is the notification daemon (Omarchy's built-in one has to stay off),
# but the jankeesvw.notification-center plugin only archives the files Omarchy's
# built-in service writes to ~/.local/state/omarchy/notifications/history/.
#
# This watches omapager's own history directory and drops each notification
# into that folder in the built-in service's format, so Notification Center
# picks it up exactly as before. Neither plugin is modified.
#
# Files it writes are named <ms>-omapager-<key>.json; only those are ever
# pruned: beyond the newest $KEEP, and only once the archive holds them.

set -uo pipefail
umask 077

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
src=${OMAPAGER_HISTORY:-$state_home/omarchy/omapager/history}
dest=${NC_SRC_HISTORY:-$state_home/omarchy/notifications/history}
archive=${NC_ARCHIVE:-$state_home/omarchy-notification-center/archive.jsonl}
KEEP=20

command -v jq >/dev/null || { echo "omapager-nc-bridge: jq missing" >&2; exit 1; }
command -v inotifywait >/dev/null || { echo "omapager-nc-bridge: inotifywait missing" >&2; exit 1; }
mkdir -p "$src" "$dest"

# Already in the archive: under our key, or as the same text within a few
# seconds (recorded by Omarchy's service back when it still ran).
archived() {
  local name=$1 file=$2
  [[ -s $archive ]] || return 1
  grep -qF "\"key\":\"$name\"" "$archive" && return 0
  local summary ms
  summary=$(jq -r '.summary // ""' "$file") || return 1
  ms=$(jq -r '((.ts // 0) * 1000 | floor)' "$file") || return 1
  [[ -n $summary ]] || return 1
  # Same title within 5s. Bodies are not compared: Omarchy kept the raw body
  # (links included) where omapager keeps the cleaned text.
  jq -e -n --arg s "$summary" --argjson ms "$ms" '
      any(inputs; .summary == $s and ((.timestamp // 0) - $ms | fabs) < 5000)' \
    "$archive" >/dev/null 2>&1
}

convert() {
  local file=$1 key ms name tmp
  [[ $file == *.json && -s $file ]] || return 0
  jq -e . "$file" >/dev/null 2>&1 || return 0
  key=$(jq -r '.key // empty' "$file") || return 0
  ms=$(jq -r '((.ts // 0) * 1000 | floor)' "$file") || return 0
  [[ -n $key && $ms =~ ^[0-9]+$ && $ms -gt 0 ]] || return 0
  [[ $key =~ ^[A-Za-z0-9_]+$ ]] || return 0
  name="$ms-omapager-$key"
  [[ -e $dest/$name.json ]] && return 0
  archived "$name" "$file" && return 0

  tmp="$dest/.$name.tmp"
  jq '{
        id: (.originalId // 0),
        originalId: (.originalId // 0),
        app: (.app // ""),
        appIcon: (.appIcon // ""),
        summary: (.summary // ""),
        body: (.body // .bodyLine // ""),
        image: "",
        glyph: "",
        execArgv: "",
        urgency: (.urgency // 1),
        expireTimeout: (.expireTimeout // 0),
        timestamp: ((.ts // 0) * 1000 | floor)
      }' "$file" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  # A rename, so the watcher sees a finished file (moved_to).
  mv -f "$tmp" "$dest/$name.json"
}

prune() {
  local files
  mapfile -t files < <(ls -1 "$dest" 2>/dev/null | grep -E '^[0-9]+-omapager-[A-Za-z0-9_]+\.json$' | sort -rn)
  (( ${#files[@]} > KEEP )) || return 0
  for f in "${files[@]:KEEP}"; do
    grep -qF "\"key\":\"${f%.json}\"" "$archive" 2>/dev/null && rm -f -- "$dest/$f"
  done
}

# Catch up on anything that closed while this was not running, oldest first.
while IFS= read -r f; do
  convert "$src/$f"
  sleep 0.05
done < <(ls -1 "$src" 2>/dev/null | grep '\.json$' | sort -n)
prune

exec 3< <(inotifywait -m -q -e close_write -e moved_to --format '%w%f' "$src" 2>/dev/null)
watcher=$!
trap 'kill "$watcher" 2>/dev/null' EXIT INT TERM
while IFS= read -r file <&3; do
  convert "$file"
  prune
done

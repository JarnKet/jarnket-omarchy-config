+// Local addition: the chat stays in front when something other than the toggle goes to its session. Clicking the session
+// in the sidebar (or anything else that runs `pane.focus` on its terminal) makes Herdr move the tab's zoom from the chat to
+// the terminal. `views` holds what the person last chose for each terminal ("chat" or "terminal"; the toggle and the
+// chat's own trips to the terminal write it), and `before` each tab's zoomed pane at the last render. A zoom that moved
+// from a chat to its own terminal, with the terminal not chosen, goes back to the chat.
+export const VIEWS = "chatpane.view";
+
+export function zoomsOf(panes) {
+  const out = {};
+  for (const p of panes) if (p.zoomed) out[p.tab] = p.pane;
+  return out;
+}
+
+export function keepChatSteps(panes, pairs, views, before) {
+  const steps = [];
+  for (const term of panes) {
+    if (!term.zoomed || !isSession(term) || views?.[term.terminal] === "terminal") continue;
+    const was = before?.[term.tab];
+    if (!was || was === term.pane) continue;
+    const chat = panes.find((p) => p.pane === was && p.mod === CHAT && p.tab === term.tab && pairs[p.pane] === term.terminal);
+    if (!chat) continue;
+    steps.push(["pane.zoom", { pane: chat.pane }]);
+    if (term.focused) steps.push(["pane.focus", { pane: chat.pane }]);
+  }
+  return steps;
+}
+
 export function tidyPairs(pairs, panes) {
   const live = new Set(panes.filter((p) => p.mod === CHAT).map((p) => p.pane));
   return Object.fromEntries(Object.entries(pairs ?? {}).filter(([pane]) => live.has(pane)));

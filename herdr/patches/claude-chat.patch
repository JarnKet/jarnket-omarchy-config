diff -ruN a/claude-chat/mention.js b/claude-chat/mention.js
--- a/claude-chat/mention.js
+++ b/claude-chat/mention.js
@@ -0,0 +1,65 @@
+// Local addition: @ file mentions in the composer, as Claude Code's own prompt has them. Typing @ offers the session
+// folder's files and folders; Enter, Tab or a click puts the path in, and Claude Code reads the file when the message
+// lands. No Herdr imports, so `node` can load this file. commands.js runs FILES and draws the rows with the / list's card.
+
+export const MENTION_GROUP = "Files";
+const MAX_ROWS = 50;
+
+// The @word being typed at the end of the text: { at, query }, `at` being where its @ is. Null when there's none.
+// An @ inside a word (an email address) doesn't count.
+export function mentionAt(text) {
+  const m = /(^|\s)@([^\s@]*)$/.exec(String(text ?? ""));
+  return m ? { at: m.index + m[1].length, query: m[2] } : null;
+}
+
+// sh -c FILES <name> <folder>: paths under the folder, one per line, folders ending in "/". In a git repo, git's own list
+// (tracked and untracked, without what's ignored); elsewhere `find` three levels deep, skipping dot folders and the
+// usual build and package folders. At most 20000 lines.
+export const FILES = `cd "$1" 2>/dev/null || exit 0
+if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
+  git ls-files -co --exclude-standard 2>/dev/null | head -n 20000
+else
+  find . -mindepth 1 -maxdepth 3 \\( -name '.*' -o -name node_modules -o -name target -o -name dist -o -name build -o -name __pycache__ \\) -prune \\
+    -o \\( -type d -printf '%P/\\n' -o -type f -printf '%P\\n' \\) 2>/dev/null | head -n 20000
+fi`;
+
+// FILES' output as a list, with the folders of git's files added (git lists files only).
+export function parseFiles(text) {
+  const out = new Set();
+  for (const line of String(text ?? "").split("\n")) {
+    const p = line.trim();
+    if (!p) continue;
+    out.add(p);
+    let i = p.lastIndexOf("/", p.length - 2);
+    while (i > 0) { out.add(p.slice(0, i + 1)); i = p.lastIndexOf("/", i - 1); }
+  }
+  return [...out];
+}
+
+// Rows for the card, best first: a path that starts with what's typed, then one whose last part does, then one that has it
+// anywhere; shorter paths first within each. Rows look like the / list's: { name: "@path", desc, group, hit }.
+export function filterFiles(paths, query, max = MAX_ROWS) {
+  const q = String(query ?? "").toLowerCase();
+  const scored = [];
+  for (const p of paths) {
+    const l = p.toLowerCase();
+    const base = l.slice(l.lastIndexOf("/", l.length - 2) + 1);
+    let rank;
+    if (!q) rank = 0;
+    else if (l.startsWith(q)) rank = 0;
+    else if (base.startsWith(q)) rank = 1;
+    else if (l.includes(q)) rank = 2;
+    else continue;
+    scored.push({ p, rank, at: q ? l.indexOf(q) : -1 });
+  }
+  scored.sort((a, b) => a.rank - b.rank || a.p.length - b.p.length || a.p.localeCompare(b.p));
+  return scored.slice(0, max).map(({ p, at }) => ({
+    name: `@${p}`, desc: "", group: MENTION_GROUP, hit: at >= 0 ? [1 + at, 1 + at + q.length] : null,
+  }));
+}
+
+// The text with the @word replaced by the picked path. A file gets a space after it; a folder doesn't, so typing goes on
+// inside it and the list follows.
+export function applyMention(text, at, path) {
+  return `${String(text).slice(0, at)}@${path}${path.endsWith("/") ? "" : " "}`;
+}

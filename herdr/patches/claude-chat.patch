+// Local addition: the chat's corners follow the desktop theme. Omarchy themes set Hyprland's `decoration:rounding`;
+// one with square windows (0, as Shadow One, ThinkPad or Blueprint) gets a square chat, any other keeps the chat's own
+// radii. No Herdr imports here except `exec`, read through the argument, so `node` can load it.
+let radius = null, checkedAt = 0;
+
+// A radius as drawn: the one asked for, or 0 under a square theme. Circles (`rounded_full`) stay round.
+export const corner = (n) => (radius === 0 ? 0 : n);
+
+// Reads Hyprland's rounding at most every `everyMs`. True when it changed, so the caller redraws.
+export async function checkCorners(exec, everyMs = 30_000, now = Date.now()) {
+  if (now - checkedAt < everyMs) return false;
+  checkedAt = now;
+  let n = NaN;
+  try {
+    const out = await exec("hyprctl", ["getoption", "decoration:rounding", "-j"]);
+    n = Number(JSON.parse(out?.stdout ?? "{}").int);
+  } catch { return false; }
+  if (!Number.isFinite(n) || n === radius) return false;
+  radius = n;
+  return true;
+}

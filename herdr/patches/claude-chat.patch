+// Local addition: OpenUI (openGPUI, mods/opengpui) panels in the chat. When an agent runs `opengpui show FILE`, tail.py
+// puts the parsed command on its tool row as `oui`. The chat lists those panels above the composer, opens one in a
+// floating window on a click, and in chat mode moves the pane the CLI split off into that window, so the terminal stays
+// hidden. No Herdr imports, so `node` can load this file. The props match the CLI's own (`show` in cli/opengpui.mjs), so
+// clicks answer the agent the same way and the events land in the same file.
+
+// The CLI's pathTag: FNV-1a over the path, as 8 hex digits.
+export function pathTag(path) {
+  let h = 2166136261;
+  for (let i = 0; i < path.length; i++) {
+    h ^= path.charCodeAt(i);
+    h = Math.imul(h, 16777619);
+  }
+  return (h >>> 0).toString(16).padStart(8, "0");
+}
+
+// The CLI's eventsPath: <app home>/opengpui/events/<file name without extension>-<tag>.jsonl.
+export function eventsPath(appHome, src) {
+  const name = `${src.split("/").pop().replace(/\.[^.]*$/, "").replace(/[^\w.-]+/g, "_")}-${pathTag(src)}`;
+  return `${appHome}/opengpui/events/${name}.jsonl`;
+}
+
+export const shownPath = (events) => events.replace(/\.jsonl$/, ".shown.json");
+
+// An absolute, tidy path for what the command named: ~ is home, a relative path is from the session's folder.
+export function resolvePath(file, cwd, home) {
+  let p = String(file);
+  if (p === "~" || p.startsWith("~/")) p = home + p.slice(1);
+  else if (!p.startsWith("/")) p = `${cwd}/${p}`;
+  const out = [];
+  for (const part of p.split("/")) {
+    if (!part || part === ".") continue;
+    if (part === "..") out.pop();
+    else out.push(part);
+  }
+  return `/${out.join("/")}`;
+}
+
+// The panel's props, as the CLI would give them. `terminal` answers unless the command said otherwise.
+export function panelProps(oui, { cwd, home, appHome, terminal }) {
+  const src = resolvePath(oui.file, cwd, home);
+  const reply = oui.noReply ? null : oui.reply ?? terminal ?? null;
+  const props = { src, events: eventsPath(appHome, src), cli: `${appHome}/mods/opengpui/cli/opengpui` };
+  if (reply) props.reply = reply;
+  for (const key of ["title", "library", "tools", "look"]) if (oui[key]) props[key] = oui[key];
+  if (oui.components) props.components = String(oui.components).split(",").map((c) => c.trim()).filter(Boolean);
+  if (props.tools) props.tools = resolvePath(props.tools, cwd, home);
+  return props;
+}
+
+export const panelTitle = (props) => props.title ?? props.src.split("/").pop();
+export const windowKey = (props) => `oui:${props.events}`;
+
+// openOverlay's argument for a panel's window: a thin bar to drag it by and close it, then the panel. `key` remembers
+// where it was put, and opening the same panel again replaces it.
+export function windowSpec(props, { width = 620, height = 560 } = {}) {
+  const key = windowKey(props);
+  return {
+    kind: "window", key, width, height,
+    layout: {
+      type: "column",
+      children: [
+        { type: "block", size: { px: 30 }, content: { mod: "oui-window", props: { title: panelTitle(props), key } } },
+        { type: "block", content: { mod: "opengpui", props } },
+      ],
+    },
+  };
+}
+
+// The panels a thread's rows showed, newest first, one per file.
+export function panelsOf(rows, context, max = 4) {
+  const seen = new Set(), out = [];
+  for (let i = rows.length - 1; i >= 0 && out.length < max; i--) {
+    const row = rows[i];
+    if (row?.kind !== "tool" || !row.oui?.file) continue;
+    const props = panelProps(row.oui, context);
+    if (seen.has(props.events)) continue;
+    seen.add(props.events);
+    out.push({ id: row.id, at: row.at, place: row.oui.place ?? "right", props });
+  }
+  return out;
+}

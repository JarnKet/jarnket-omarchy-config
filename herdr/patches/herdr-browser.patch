+// Local addition (omarchy-config): the shared session runs on a profile that's kept, so logins made there stay. A profile
+// can only be open in one browser at a time, so any other session starts empty, as before. Brave reopens the last tabs by
+// default, which would put an old page in front of the one asked for, so a new profile starts on a new tab instead.
+// The wrapper in ~/.local/bin sets HERDR_BROWSER_PROFILE and the browser (AGENT_BROWSER_ENGINE, _EXECUTABLE_PATH).
+const SHARED = "herdr";
+const PASSED = ["AGENT_BROWSER_ENGINE", "AGENT_BROWSER_EXECUTABLE_PATH", "HERDR_BROWSER_PROFILE"];
+function useProfile(session) {
+  const dir = process.env.HERDR_BROWSER_PROFILE;
+  delete process.env.AGENT_BROWSER_PROFILE;
+  if (!dir || session !== SHARED) return;
+  const prefs = path.join(dir, "Default", "Preferences");
+  if (!fs.existsSync(prefs)) {
+    fs.mkdirSync(path.dirname(prefs), { recursive: true });
+    fs.writeFileSync(prefs, JSON.stringify({ session: { restore_on_startup: 5 } }));
+  }
+  process.env.AGENT_BROWSER_PROFILE = dir;
+}

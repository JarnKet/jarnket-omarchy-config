{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "space-agents",
          "type": "block",
          "content": {
            "mod": "space-agents"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "usage",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "over9k-usage"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "window_drag": true
            },
            {
              "id": "panel-buttons",
              "type": "block",
              "size": {
                "px": 330
              },
              "content": {
                "mod": "panel-buttons"
              },
              "window_drag": true
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-header"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "symbols-icons"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "gitview",
                        "props": {
                          "replaces": {
                            "mod": "changes"
                          }
                        }
                      }
                    },
                    {
                      "id": "tickets",
                      "type": "block",
                      "content": {
                        "mod": "tickets"
                      }
                    },
                    {
                      "id": "orchi",
                      "type": "block",
                      "content": {
                        "mod": "orchi"
                      }
                    },
                    {
                      "id": "herd",
                      "type": "block",
                      "content": {
                        "mod": "herd"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "git-graph"
                      }
                    },
                    {
                      "id": "todo",
                      "type": "block",
                      "content": {
                        "mod": "over9k-todos"
                      }
                    },
                    {
                      "id": "prompts",
                      "type": "block",
                      "content": {
                        "mod": "over9k-prompts"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 320,
              "max": 6000,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
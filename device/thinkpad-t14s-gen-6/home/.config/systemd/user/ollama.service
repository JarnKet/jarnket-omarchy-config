[Unit]
Description=Ollama (local LLM server, user instance)
Documentation=https://github.com/ollama/ollama
After=default.target

[Service]
ExecStart=/usr/bin/ollama serve
# Localhost only; models live in ~/.ollama/models
Environment=OLLAMA_HOST=127.0.0.1:11434
# Radeon 880M is an integrated GPU: Ollama skips iGPUs unless told otherwise
Environment=OLLAMA_IGPU_ENABLE=1
# 32 GB laptop: one model in memory at a time, one request at a time
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_KEEP_ALIVE=10m
Environment=OLLAMA_CONTEXT_LENGTH=8192
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
# Offline-first: no Ollama cloud models or web search
Environment=OLLAMA_NO_CLOUD=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
